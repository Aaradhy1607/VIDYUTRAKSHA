# VIDYUTRAKSHA - Operational Environment Variables Example
PROJECT_NAME=VIDYUTRAKSHA
SYSTEM_VERSION=1.0.0-PROD
ENVIRONMENT=production
DEBUG=False

# API Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./vidyutraksha.db

# Grid & Analysis
DEFAULT_GRID_RESOLUTION_DEG=0.05
HIGHRES_GRID_RESOLUTION_DEG=0.02
